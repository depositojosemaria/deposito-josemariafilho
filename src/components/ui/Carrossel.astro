---
interface Props {
	duracao?: string;
}

const { duracao = '45s' } = Astro.props;
const duracaoCss = /^\d+(\.\d+)?s$/.test(duracao) ? duracao : '45s';
---

<div class="carrossel" style={`--carrossel-duracao: ${duracaoCss}`}>
	<div class="carrossel-trilho">
		<slot />
	</div>
</div>

<style>
	.carrossel {
		position: relative;
		overflow: hidden;
		padding: 8px 0;
	}

	.carrossel::before,
	.carrossel::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		z-index: 2;
		width: 80px;
		pointer-events: none;
	}

	.carrossel::before {
		left: 0;
		background: linear-gradient(to right, var(--color-surface), transparent);
	}

	.carrossel::after {
		right: 0;
		background: linear-gradient(to left, var(--color-surface), transparent);
	}

	.carrossel-trilho {
		display: flex;
		align-items: stretch;
		width: max-content;
		animation: carrossel-rolar var(--carrossel-duracao) linear infinite;
	}

	.carrossel-trilho:hover,
	.carrossel-trilho:focus-within {
		animation-play-state: paused;
	}

	.carrossel-trilho :global(.carrossel-grupo) {
		display: flex;
		align-items: stretch;
		gap: var(--spacing-reviews-gap);
		margin: 0;
		padding: 0 var(--spacing-reviews-gap) 0 0;
		list-style: none;
	}

	@keyframes carrossel-rolar {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.carrossel {
			overflow: visible;
		}

		.carrossel::before,
		.carrossel::after {
			content: none;
		}

		.carrossel-trilho {
			flex-wrap: wrap;
			justify-content: center;
			width: auto;
			max-width: var(--container-page);
			margin-inline: auto;
			padding-inline: var(--spacing-container-x);
			animation: none !important;
		}

		.carrossel-trilho :global(.carrossel-copia) {
			display: none;
		}

		.carrossel-trilho :global(.carrossel-grupo) {
			flex-wrap: wrap;
			justify-content: center;
			width: 100%;
			padding-right: 0;
		}
	}
</style>
