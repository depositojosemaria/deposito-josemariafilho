---
import { Picture } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import fachada from '../../assets/images/fachada-loja-poa.png';
import { linkTelefone, linkWhatsApp } from '../../lib/format';
import Icon from '../ui/Icon.astro';

const site = await getEntry('site', 'geral');
if (!site) {
	throw new Error('A collection site não tem o item geral.');
}

const unidades = await getCollection('unidades');
const loja1 = [...unidades].sort((a, b) => a.data.ordem - b.data.ordem)[0];
const telefone = loja1?.data.telefone;
const textoTelefone = site.data.ctaTelefoneHero;
const indiceTelefone = telefone ? textoTelefone.indexOf(telefone) : -1;
const telefoneAntes = indiceTelefone >= 0 ? textoTelefone.slice(0, indiceTelefone) : textoTelefone;
const telefoneDepois = indiceTelefone >= 0 && telefone ? textoTelefone.slice(indiceTelefone + telefone.length) : '';

const destaque = 'obra';
const indiceDestaque = site.data.tituloHero.indexOf(destaque);
const tituloAntes = indiceDestaque >= 0 ? site.data.tituloHero.slice(0, indiceDestaque) : site.data.tituloHero;
const tituloDestaque = indiceDestaque >= 0 ? site.data.tituloHero.slice(indiceDestaque, indiceDestaque + destaque.length) : '';
const tituloDepois = indiceDestaque >= 0 ? site.data.tituloHero.slice(indiceDestaque + destaque.length) : '';

const whatsapp = linkWhatsApp(site.data.whatsapp, site.data.mensagemWhatsapp);
---

<section class="hero" id="inicio">
	<div class="hero-foto">
		<Picture
			src={fachada}
			formats={['avif', 'webp']}
			widths={[480, 768, 1024, 1440, 1920]}
			sizes="100vw"
			alt=""
			width={fachada.width}
			height={fachada.height}
			quality={60}
			loading="eager"
			decoding="async"
			fetchpriority="high"
			role="presentation"
		/>
	</div>
	<div class="hero-overlay" aria-hidden="true"></div>
	<div class="hero-container">
		<div class="hero-content">
			<p class="hero-badge">{site.data.selo}</p>
			<h1>
				{tituloAntes}{tituloDestaque && <span>{tituloDestaque}</span>}{tituloDepois}
			</h1>
			<p class="hero-copy">{site.data.subtituloHero}</p>
			<div class="hero-ctas">
				<a class="btn-whatsapp" href={whatsapp} target="_blank" rel="noopener">
					<Icon nome="whatsapp" tamanho={22} />
					{site.data.ctaWhatsapp}
				</a>
				{
					telefone && indiceTelefone >= 0 && (
						<p class="hero-phone">
							<Icon nome="telefone" tamanho={18} />
							{telefoneAntes}
							<a href={linkTelefone(telefone)}>{telefone}</a>
							{telefoneDepois}
						</p>
					)
				}
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		min-height: var(--height-hero);
		overflow: hidden;
		background: var(--color-ink);
	}

	.hero-foto {
		position: absolute;
		inset: 0;
		opacity: var(--opacity-hero-photo);
	}

	.hero-foto :global(picture),
	.hero-foto :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.hero-foto :global(img) {
		object-fit: cover;
		object-position: center 30%;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			var(--color-hero-overlay-start) 0%,
			var(--color-hero-overlay-end) 100%
		);
	}

	.hero-container {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: var(--container-page);
		margin: 0 auto;
		padding: 0 var(--spacing-container-x);
	}

	.hero-content {
		max-width: var(--container-hero);
		padding: 60px var(--spacing-container-x);
		color: var(--color-white);
	}

	.hero-badge {
		display: inline-block;
		margin-bottom: 24px;
		padding: 6px 18px;
		border: 1px solid var(--color-hero-badge-border);
		border-radius: var(--radius-pill);
		background: var(--color-hero-badge);
		font-size: var(--text-hero-badge);
		font-weight: var(--font-weight-label);
		letter-spacing: var(--tracking-hero-badge);
		backdrop-filter: blur(8px);
	}

	h1 {
		margin: 0 0 20px;
		font-family: var(--font-display);
		font-size: var(--text-hero);
		font-weight: var(--font-weight-black);
		line-height: var(--leading-hero);
	}

	h1 span {
		color: var(--color-gold);
	}

	.hero-copy {
		max-width: var(--container-hero-copy);
		margin: 0 0 36px;
		font-size: var(--text-hero-copy);
		opacity: 0.9;
	}

	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px;
	}

	.btn-whatsapp {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: var(--spacing-hero-btn-y) var(--spacing-hero-btn-x);
		border-radius: var(--radius-pill);
		background: var(--color-whatsapp);
		color: var(--color-white);
		font-family: var(--font-display);
		font-size: var(--text-hero-cta);
		font-weight: var(--font-weight-bold);
		text-decoration: none;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	.btn-whatsapp:hover {
		background: var(--color-whatsapp-dark);
		transform: translateY(-2px);
	}

	.hero-phone {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		color: rgba(255, 255, 255, 0.85);
		font-size: var(--text-hero-phone);
	}

	.hero-phone a {
		color: var(--color-white);
		font-weight: var(--font-weight-bold);
		text-decoration: underline;
	}
</style>
