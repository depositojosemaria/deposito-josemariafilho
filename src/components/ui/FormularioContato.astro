---
import { getEntry } from 'astro:content';
import { linkWhatsApp } from '../../lib/format';
import Icon from './Icon.astro';

const site = await getEntry('site', 'geral');
if (!site) {
	throw new Error('A collection site não tem o item geral.');
}

function numeroWhatsapp(numero: string) {
	let digitos = numero.replace(/\D/g, '');
	if (digitos.startsWith('0') && (digitos.length === 11 || digitos.length === 12)) {
		digitos = digitos.slice(1);
	}
	if (!digitos.startsWith('55') && (digitos.length === 10 || digitos.length === 11)) {
		digitos = `55${digitos}`;
	}
	return digitos;
}

const numero = numeroWhatsapp(site.data.whatsapp);
const whatsapp = linkWhatsApp(site.data.whatsapp, site.data.mensagemWhatsapp);
---

<div class="contato-inner">
	<div class="contato-info">
		<h3>Prefere falar direto pelo WhatsApp?</h3>
		<p>
			Nossa equipe está pronta para te atender e tirar todas as suas dúvidas sobre produtos, preços e
			disponibilidade. Clique no botão e mande uma mensagem agora!
		</p>
		<a class="btn-whatsapp" href={whatsapp} target="_blank" rel="noopener">
			<Icon nome="whatsapp" tamanho={22} />
			{site.data.ctaWhatsapp}
		</a>
	</div>
	<form
		id="contato-form"
		method="get"
		action={`https://wa.me/${numero}`}
		target="_blank"
		data-whatsapp={numero}
	>
		<div class="form-row">
			<div class="form-group">
				<label for="nome">Nome <span aria-hidden="true">*</span></label>
				<input
					id="nome"
					name="nome"
					type="text"
					autocomplete="name"
					placeholder="Seu nome completo"
					required
				/>
			</div>
			<div class="form-group">
				<label for="telefone">Telefone</label>
				<input
					id="telefone"
					name="telefone"
					type="tel"
					inputmode="tel"
					autocomplete="tel"
					placeholder="(11) 99999-9999"
				/>
			</div>
		</div>
		<div class="form-group">
			<label for="email">E-mail <span aria-hidden="true">*</span></label>
			<input id="email" name="email" type="email" autocomplete="email" placeholder="seu@email.com" required />
		</div>
		<div class="form-group">
			<label for="mensagem">Mensagem <span aria-hidden="true">*</span></label>
			<textarea id="mensagem" name="text" placeholder="Descreva o que você precisa..." required></textarea>
		</div>
		<button type="submit">{site.data.ctaEnviar}</button>
		<p class="aviso">
			Ao enviar, você será direcionado ao WhatsApp com sua mensagem pronta. Veja nossa
			<a href="/politica-de-privacidade/">Política de Privacidade</a>
		</p>
	</form>
</div>

<script is:inline>
	const form = document.getElementById('contato-form');
	form.addEventListener('submit', (event) => {
		event.preventDefault();
		const dados = new FormData(form);
		const linhas = ['*Novo contato pelo site*', '*Nome:* ' + dados.get('nome')];
		const telefone = String(dados.get('telefone') || '').trim();
		if (telefone) linhas.push('*Telefone:* ' + telefone);
		linhas.push('*E-mail:* ' + dados.get('email'), '*Mensagem:* ' + dados.get('text'));
		window.dataLayer = window.dataLayer || [];
		window.dataLayer.push({ event: 'lead_formulario_whatsapp' });
		const numero = form.getAttribute('data-whatsapp');
		window.location.href = 'https://wa.me/' + numero + '?text=' + encodeURIComponent(linhas.join('\n'));
	});
</script>

<style>
	.contato-inner {
		display: grid;
		gap: var(--spacing-contact-gap-compact);
		align-items: start;
	}

	h3 {
		margin: 0 0 16px;
		font-family: var(--font-display);
		font-size: var(--text-contact-title);
		font-weight: var(--font-weight-bold);
		line-height: var(--leading-heading);
	}

	.contato-info p {
		margin: 0 0 28px;
		line-height: 1.7;
		opacity: 0.85;
	}

	.btn-whatsapp {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: var(--spacing-hero-btn-y) var(--spacing-hero-btn-x);
		border-radius: var(--radius-pill);
		background: var(--color-whatsapp);
		box-shadow: var(--shadow-contact-cta);
		color: var(--color-white);
		font-family: var(--font-display);
		font-size: var(--text-contact-cta);
		font-weight: var(--font-weight-bold);
		text-decoration: none;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	.btn-whatsapp:hover {
		background: var(--color-whatsapp-dark);
		transform: translateY(-2px);
	}

	.form-row {
		display: grid;
		gap: var(--spacing-form-group);
	}

	.form-group {
		margin-bottom: var(--spacing-form-group);
	}

	label {
		display: block;
		margin-bottom: 6px;
		font-size: var(--text-form-label);
		font-weight: var(--font-weight-label);
		opacity: 0.9;
	}

	input,
	textarea {
		width: 100%;
		padding: 12px 16px;
		border: 2px solid rgba(255, 255, 255, 0.2);
		border-radius: var(--radius-control);
		background: rgba(255, 255, 255, 0.12);
		color: var(--color-white);
		font-family: var(--font-sans);
		font-size: var(--text-form-field);
		outline: none;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	textarea {
		min-height: 110px;
		resize: vertical;
	}

	input::placeholder,
	textarea::placeholder {
		color: rgba(255, 255, 255, 0.5);
	}

	input:focus,
	textarea:focus {
		border-color: rgba(255, 255, 255, 0.6);
		background: rgba(255, 255, 255, 0.18);
	}

	input:focus-visible,
	textarea:focus-visible {
		border-color: rgba(255, 255, 255, 0.6);
		outline: 3px solid var(--color-white);
		outline-offset: 3px;
		background: rgba(255, 255, 255, 0.18);
	}

	input:user-invalid,
	textarea:user-invalid {
		border-color: var(--color-gold);
		background: rgba(255, 215, 0, 0.16);
	}

	button {
		width: 100%;
		padding: 15px;
		border: none;
		border-radius: var(--radius-pill);
		background: var(--color-white);
		color: var(--color-brand);
		font-family: var(--font-display);
		font-size: var(--text-form-submit);
		font-weight: var(--font-weight-extrabold);
		cursor: pointer;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	button:hover {
		background: var(--color-ink);
		color: var(--color-white);
	}

	.aviso {
		margin: 12px 0 0;
		font-size: 0.78rem;
		line-height: 1.5;
		opacity: 0.85;
	}

	.aviso a {
		color: var(--color-white);
		text-decoration: underline;
	}

	@media (min-width: 801px) {
		.contato-inner {
			grid-template-columns: 1fr 1fr;
			gap: var(--spacing-contact-gap);
		}

		.form-row {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
