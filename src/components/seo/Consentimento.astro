<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		dataLayer.push(arguments);
	}
	gtag('consent', 'default', {
		ad_storage: 'denied',
		ad_user_data: 'denied',
		ad_personalization: 'denied',
		analytics_storage: 'denied',
		wait_for_update: 500,
	});
	try {
		var salvo = JSON.parse(localStorage.getItem('consentimento-cookies'));
		if (salvo && salvo.versao === 1) {
			gtag('consent', 'update', {
				analytics_storage: salvo.analytics ? 'granted' : 'denied',
				ad_storage: salvo.ads ? 'granted' : 'denied',
				ad_user_data: salvo.ads ? 'granted' : 'denied',
				ad_personalization: salvo.ads ? 'granted' : 'denied',
			});
		}
	} catch (e) {}
</script>
