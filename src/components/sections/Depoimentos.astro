---
import { getCollection, getEntry } from 'astro:content';
import Carrossel from '../ui/Carrossel.astro';
import DepoimentoCard from '../ui/DepoimentoCard.astro';

interface Props {
	limite?: number;
	estatico?: boolean;
	titulo?: string;
	destaque?: string;
}

const { limite, estatico = false, titulo, destaque } = Astro.props;

const site = await getEntry('site', 'geral');
if (!site) {
	throw new Error('A collection site não tem o item geral.');
}

const depoimentos = [...(await getCollection('depoimentos'))].sort(
	(a, b) => a.data.ordem - b.data.ordem,
);
const unidades = [...(await getCollection('unidades'))].sort((a, b) => a.data.ordem - b.data.ordem);
const linkAvaliacoes = unidades[0]?.data.mapsUrl;

const avatarPorId: Record<string, string> = {
	'ronaldo-marinho-cabral': 'avatar-ronaldo',
	'jurisbalino-da-silva': 'avatar-jurisbalino',
	'fabio-mendes': 'avatar-fabio',
	'helio-venegeroles': 'avatar-helio',
	'jonatas-abrao': 'avatar-jonatas',
};

const avatares = [
	'avatar-ronaldo',
	'avatar-jurisbalino',
	'avatar-fabio',
	'avatar-helio',
	'avatar-jonatas',
];

function classeAvatar(id: string, indice: number) {
	return avatarPorId[id] ?? avatares[indice % avatares.length];
}

function comDestaque(texto: string, trecho?: string) {
	if (!trecho) return { antes: texto, destaque: '', depois: '' };
	const indice = texto.indexOf(trecho);
	if (indice < 0) return { antes: texto, destaque: '', depois: '' };
	return {
		antes: texto.slice(0, indice),
		destaque: trecho,
		depois: texto.slice(indice + trecho.length),
	};
}

const lista = limite === undefined ? depoimentos : depoimentos.slice(0, limite);
const tituloPartes = titulo ? comDestaque(titulo, destaque) : undefined;
---

<section class="depoimentos" id="depoimentos">
	<div class="container">
		<div class="intro">
			<h2>
				{
					tituloPartes ? (
						<>
							{tituloPartes.antes}
							{tituloPartes.destaque && <span>{tituloPartes.destaque}</span>}
							{tituloPartes.depois}
						</>
					) : (
						<>
							O que nossos <span>Clientes</span> Dizem
						</>
					)
				}
			</h2>
			{!titulo && <p>Avaliações verificadas no Google</p>}
		</div>
	</div>
	{
		estatico ? (
			<div class="container">
				<ul class="depoimentos-grid">
					{lista.map((item, indice) => (
						<DepoimentoCard
							autor={item.data.autor}
							nota={item.data.nota}
							texto={item.data.texto}
							avatar={classeAvatar(item.id, indice)}
							fluido
						/>
					))}
				</ul>
			</div>
		) : (
			<Carrossel duracao="45s">
				{[false, true].map((copia) => (
					<ul
						class:list={['carrossel-grupo', { 'carrossel-copia': copia }]}
						aria-hidden={copia ? 'true' : undefined}
						inert={copia ? true : undefined}
					>
						{lista.map((item, indice) => (
							<DepoimentoCard
								autor={item.data.autor}
								nota={item.data.nota}
								texto={item.data.texto}
								avatar={classeAvatar(item.id, indice)}
							/>
						))}
					</ul>
				))}
			</Carrossel>
		)
	}
	{
		linkAvaliacoes && (
			<div class="container">
				<div class="avaliacoes">
					<a href={linkAvaliacoes} target="_blank" rel="noopener">
						<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24">
							<path
								d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
								fill="#4285F4"
							/>
							<path
								d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
								fill="#34A853"
							/>
							<path
								d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
								fill="#FBBC05"
							/>
							<path
								d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
								fill="#EA4335"
							/>
						</svg>
						{site.data.ctaAvaliacoes}
					</a>
				</div>
			</div>
		)
	}
</section>

<style>
	.depoimentos {
		background: var(--color-surface);
		padding: var(--spacing-section) 0;
	}

	.container {
		max-width: var(--container-page);
		margin: 0 auto;
		padding: 0 var(--spacing-container-x);
	}

	.intro {
		text-align: center;
	}

	h2 {
		margin: 0 0 var(--spacing-title);
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: var(--text-section-title);
		font-weight: var(--font-weight-extrabold);
		line-height: var(--leading-heading);
	}

	h2 span {
		color: var(--color-brand);
	}

	.intro p {
		margin: 0 0 var(--spacing-subtitle);
		color: var(--color-review-kicker);
		font-size: var(--text-section-subtitle);
	}

	.depoimentos-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-reviews-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.avaliacoes {
		margin-top: var(--spacing-reviews-button);
		text-align: center;
	}

	.avaliacoes a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 13px 28px;
		border: 2px solid var(--color-review-button-border);
		border-radius: var(--radius-pill);
		background: var(--color-white);
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: var(--text-reviews-button);
		font-weight: var(--font-weight-bold);
		text-decoration: none;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	.avaliacoes a:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	@media (min-width: 901px) {
		.depoimentos-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
