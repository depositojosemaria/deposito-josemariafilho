---
import { Image, Picture } from 'astro:assets';
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Icon from '../../components/ui/Icon.astro';
import UnidadeCard from '../../components/ui/UnidadeCard.astro';
import { linkTelefone, linkWhatsApp } from '../../lib/format';
import { lojaSchema } from '../../lib/schema';

interface Props {
	unidade: CollectionEntry<'unidades'>;
}

export async function getStaticPaths() {
	const unidades = await getCollection('unidades');
	return unidades.map((unidade) => ({
		params: { id: unidade.id },
		props: { unidade },
	}));
}

const { unidade } = Astro.props;
const site = await getEntry('site', 'geral');
if (!site) {
	throw new Error('A collection site não tem o item geral.');
}

const { data } = unidade;
const unidades = [...(await getCollection('unidades'))].sort((a, b) => a.data.ordem - b.data.ordem);
const outras = unidades.filter((item) => item.id !== unidade.id);
const categorias = [...(await getCollection('categorias'))].sort((a, b) => a.data.ordem - b.data.ordem);

const titulo = `Material de Construção em ${data.cidade} (${data.bairro}) | José Maria Filho`;
const enderecoLinha = [data.logradouro, data.numero, data.complemento].filter(Boolean).join(', ');
const descricaoBase = `Loja do Depósito José Maria Filho em ${data.cidade}, ${data.bairro}: ${enderecoLinha}. Materiais básicos, pisos, elétrica, hidráulica e mais. Fale no WhatsApp.`;
const descricaoCurta = `Loja do Depósito José Maria Filho em ${data.cidade}, ${data.bairro}: ${enderecoLinha}. Materiais, pisos, elétrica e hidráulica. Fale no WhatsApp.`;
const descricao = descricaoBase.length <= 155 ? descricaoBase : descricaoCurta;

const consulta = [enderecoLinha, data.bairro, `${data.cidade} - ${data.uf}`, data.cep].filter(Boolean).join(', ');
const mapa = `https://www.google.com/maps?q=${encodeURIComponent(consulta)}&output=embed`;
const whatsapp = linkWhatsApp(
	data.whatsapp || data.telefone || site.data.whatsapp,
	`Olá, vim pela página da loja de ${data.bairro} no site.`,
);

const migalhas = [
	{ nome: 'Início', url: '/' },
	{ nome: 'Unidades', url: '/unidades/' },
	{ nome: data.nome, url: `/unidades/${unidade.id}/` },
];
const jsonLd = await lojaSchema(site, unidade);
---

<BaseLayout
	title={titulo}
	description={descricao}
	ogImage={data.imagem}
	ogImageAlt={data.alt}
	jsonLd={jsonLd}
>
	<div class="pagina">
		<div class="container">
			<Breadcrumb itens={migalhas} />
			<h1>Depósito José Maria Filho em {data.cidade} — {data.bairro}</h1>
			<div class="fachada">
				<Picture
					src={data.imagem}
					formats={['avif', 'webp']}
					widths={[480, 680]}
					sizes="(min-width: 1240px) 1160px, calc(100vw - 40px)"
					alt={data.alt}
					width={data.imagem.width}
					height={data.imagem.height}
					quality="mid"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
			<address class="dados">
				<p>
					{enderecoLinha}
					<br />
					{data.bairro} — {data.cidade}, {data.uf}
					{data.cep && (
						<>
							<br />
							CEP {data.cep}
						</>
					)}
				</p>
				{data.telefone && (
					<p>
						<a href={linkTelefone(data.telefone)}>{data.telefone}</a>
					</p>
				)}
				<p>
					<a href={whatsapp} target="_blank" rel="noopener">WhatsApp</a>
				</p>
				{data.horario && <p>{data.horario}</p>}
			</address>
			<div class="acoes">
				<a class="btn-maps" href={data.mapsUrl} target="_blank" rel="noopener">
					<Icon nome="pin" tamanho={16} />
					Ver no Mapa
				</a>
				<a class="btn-rota" href={data.rotaUrl} target="_blank" rel="noopener">
					<Icon nome="rota" tamanho={16} />
					Criar Rota
				</a>
			</div>
			<details class="mapa">
				<summary>Ver mapa da loja</summary>
				<iframe
					loading="lazy"
					title={`Mapa da loja ${data.nome}`}
					referrerpolicy="no-referrer-when-downgrade"
					src={mapa}></iframe>
			</details>
			<section class="linhas" aria-labelledby="linhas-titulo">
				<h2 id="linhas-titulo">O que você encontra na loja</h2>
				<p>
					Estas são as linhas de produto do Depósito José Maria Filho. A disponibilidade varia de loja para
					loja; confirme pelo WhatsApp.
				</p>
				<ul>
					{
						categorias.map((categoria) => (
							<li>
								<a href={`/produtos/${categoria.id}/`}>
									<Image
										src={categoria.data.icone}
										alt=""
										width={64}
										height={64}
										format="webp"
										quality="mid"
										loading="lazy"
										decoding="async"
									/>
									<span>{categoria.data.nome}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			<section class="outras" aria-labelledby="outras-titulo">
				<h2 id="outras-titulo">Outras unidades</h2>
				<ul>
					{outras.map((item) => <UnidadeCard unidade={item} site={site} nivel="h3" />)}
				</ul>
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.pagina {
		background: var(--color-white);
		padding: var(--spacing-section) 0;
	}

	.container {
		max-width: var(--container-page);
		margin: 0 auto;
		padding: 0 var(--spacing-container-x);
	}

	h1,
	h2 {
		margin: 0 0 var(--spacing-title);
		color: var(--color-ink);
		font-family: var(--font-display);
		font-weight: var(--font-weight-extrabold);
		line-height: var(--leading-heading);
	}

	h1 {
		font-size: var(--text-section-title);
	}

	h2 {
		font-size: clamp(1.3rem, 3vw, 1.7rem);
	}

	.fachada {
		overflow: hidden;
		margin-bottom: 28px;
		border-radius: var(--radius-card);
	}

	.fachada :global(picture),
	.fachada :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.dados {
		margin: 0 0 20px;
		color: var(--color-ink);
		font-size: var(--text-unit-address);
		font-style: normal;
		line-height: 1.5;
	}

	.dados p {
		margin: 0 0 10px;
	}

	.dados a {
		color: var(--color-brand);
		font-weight: var(--font-weight-bold);
		text-decoration: none;
	}

	.acoes {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-bottom: 28px;
	}

	.btn-maps,
	.btn-rota {
		display: inline-flex;
		flex: 1 1 160px;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 12px 18px;
		border-radius: var(--radius-pill);
		font-weight: var(--font-weight-bold);
		text-decoration: none;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	.btn-maps {
		background: var(--color-brand);
		color: var(--color-white);
	}

	.btn-maps:hover {
		background: var(--color-brand-dark);
	}

	.btn-rota {
		border: 1px solid var(--color-card-border);
		background: var(--color-white);
		color: var(--color-ink);
	}

	.btn-rota:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.mapa {
		margin-bottom: var(--spacing-section);
	}

	.mapa summary {
		cursor: pointer;
		color: var(--color-brand);
		font-weight: var(--font-weight-bold);
	}

	.mapa iframe {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		margin-top: 16px;
		border: 0;
		border-radius: var(--radius-card);
	}

	.linhas p,
	.outras {
		margin-bottom: var(--spacing-section);
	}

	.linhas p {
		margin-top: 0;
		margin-bottom: 28px;
		color: var(--color-muted);
		font-size: var(--text-section-subtitle);
	}

	.linhas ul,
	.outras ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-products-gap-compact);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.linhas a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		height: 100%;
		padding: 16px 10px;
		border: 1px solid var(--color-card-border);
		border-radius: var(--radius-card);
		background: var(--color-white);
		box-shadow: var(--shadow-card);
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: var(--font-weight-bold);
		line-height: 1.3;
		text-align: center;
		text-decoration: none;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	.linhas a:hover {
		box-shadow: var(--shadow-product-hover);
		transform: translateY(-4px);
	}

	.linhas :global(img) {
		width: 48px;
		height: 48px;
		object-fit: contain;
	}

	.outras ul {
		grid-template-columns: 1fr;
		gap: var(--spacing-units-gap);
		max-width: var(--container-units);
		margin-inline: auto;
	}

	@media (min-width: 701px) {
		.linhas ul {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--spacing-products-gap);
		}
	}

	@media (min-width: 901px) {
		.acoes {
			flex-wrap: nowrap;
		}

		.btn-maps,
		.btn-rota {
			flex: 0 1 auto;
		}

		.outras ul {
			grid-template-columns: repeat(2, 1fr);
			max-width: none;
		}
	}
</style>
