---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Icon from '../../components/ui/Icon.astro';
import UnidadeCard from '../../components/ui/UnidadeCard.astro';
import { linkWhatsApp } from '../../lib/format';

const site = await getEntry('site', 'geral');
if (!site) {
	throw new Error('A collection site não tem o item geral.');
}

const unidades = [...(await getCollection('unidades'))].sort((a, b) => a.data.ordem - b.data.ordem);
const migalhas = [
	{ nome: 'Início', url: '/' },
	{ nome: 'Unidades', url: '/unidades/' },
];
const whatsapp = linkWhatsApp(site.data.whatsapp, site.data.mensagemWhatsapp);
---

<BaseLayout
	title="Lojas de Material de Construção em Poá e Suzano | José Maria Filho"
	description="Conheça as 3 lojas do Depósito José Maria Filho em Poá e Suzano: endereços, telefones e WhatsApp. Materiais para construção há mais de 23 anos."
>
	<div class="pagina">
		<div class="container">
			<Breadcrumb itens={migalhas} />
			<header class="intro">
				<h1>Nossas <span>Unidades</span> em Poá e Suzano</h1>
				<p>Estamos onde você precisa — Poá e Suzano</p>
			</header>
			<ul class="unidades-grid">
				{unidades.map((unidade) => <UnidadeCard unidade={unidade} site={site} nivel="h2" />)}
			</ul>
			<div class="cta">
				<a class="btn-whatsapp" href={whatsapp} target="_blank" rel="noopener">
					<Icon nome="whatsapp" tamanho={20} />
					{site.data.ctaWhatsapp}
				</a>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	.pagina {
		background: var(--color-white);
		padding: var(--spacing-section) 0;
	}

	.container {
		max-width: var(--container-page);
		margin: 0 auto;
		padding: 0 var(--spacing-container-x);
	}

	.intro {
		text-align: center;
	}

	h1 {
		margin: 0 0 var(--spacing-title);
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: var(--text-section-title);
		font-weight: var(--font-weight-extrabold);
		line-height: var(--leading-heading);
	}

	h1 span {
		color: var(--color-brand);
	}

	.intro p {
		margin: 0 0 var(--spacing-subtitle);
		color: var(--color-muted);
		font-size: var(--text-section-subtitle);
	}

	.unidades-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-units-gap);
		max-width: var(--container-units);
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	.cta {
		display: flex;
		justify-content: center;
		margin-top: 22px;
	}

	.btn-whatsapp {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		max-width: 320px;
		padding: 12px 18px;
		border-radius: var(--radius-pill);
		background: var(--color-whatsapp);
		color: var(--color-white);
		font-family: var(--font-display);
		font-size: var(--text-offers-cta-compact);
		font-weight: var(--font-weight-bold);
		text-decoration: none;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	.btn-whatsapp:hover {
		background: var(--color-whatsapp-dark);
	}

	@media (min-width: 901px) {
		.unidades-grid {
			grid-template-columns: repeat(3, 1fr);
			max-width: none;
		}

		.btn-whatsapp {
			width: auto;
			max-width: none;
			padding: 13px 26px;
			font-size: var(--text-btn);
		}
	}
</style>
