---
import FormularioContato from '../ui/FormularioContato.astro';
---

<section class="contato" id="contato">
	<div class="container">
		<div class="intro">
			<h2>Entre em <span>Contato</span></h2>
			<p>Fale com nossa equipe — respondemos rapidinho!</p>
		</div>
		<FormularioContato />
	</div>
</section>

<style>
	.contato {
		background: var(--color-brand);
		color: var(--color-white);
		padding: var(--spacing-section) 0;
	}

	.container {
		max-width: var(--container-page);
		margin: 0 auto;
		padding: 0 var(--spacing-container-x);
	}

	.intro {
		text-align: center;
	}

	h2 {
		margin: 0 0 var(--spacing-title);
		color: var(--color-white);
		font-family: var(--font-display);
		font-size: var(--text-section-title);
		font-weight: var(--font-weight-extrabold);
		line-height: var(--leading-heading);
	}

	h2 span {
		color: var(--color-gold);
	}

	.intro p {
		margin: 0 0 var(--spacing-subtitle);
		color: rgba(255, 255, 255, 0.75);
		font-size: var(--text-section-subtitle);
	}
</style>
