---
import { getCollection } from 'astro:content';
import CategoriaCard from '../ui/CategoriaCard.astro';

const categorias = [...(await getCollection('categorias'))].sort((a, b) => a.data.ordem - b.data.ordem);
---

<section class="produtos" id="produtos">
	<div class="container">
		<div class="intro">
			<h2>Nossos <span>Produtos</span></h2>
			<p>Tudo que você precisa para construir, reformar e acabar com qualidade</p>
		</div>
		<ul class="produtos-grid">
			{categorias.map((categoria) => <CategoriaCard categoria={categoria} nivel="h3" />)}
		</ul>
	</div>
</section>

<style>
	.produtos {
		background: var(--color-white);
		padding: var(--spacing-section) 0;
	}

	.container {
		max-width: var(--container-page);
		margin: 0 auto;
		padding: 0 var(--spacing-container-x);
	}

	.intro {
		text-align: center;
	}

	h2 {
		margin: 0 0 var(--spacing-title);
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: var(--text-section-title);
		font-weight: var(--font-weight-extrabold);
		line-height: var(--leading-heading);
	}

	h2 span {
		color: var(--color-brand);
	}

	.intro p {
		margin: 0 0 var(--spacing-subtitle);
		color: var(--color-muted);
		font-size: var(--text-section-subtitle);
	}

	.produtos-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-products-gap-compact);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 501px) {
		.produtos-grid {
			gap: var(--spacing-products-gap);
		}
	}

	@media (min-width: 901px) {
		.produtos-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
