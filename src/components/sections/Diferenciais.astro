---
import { getCollection } from 'astro:content';

interface Props {
	linkExperiencia?: string;
}

const { linkExperiencia } = Astro.props;

const diferenciais = [...(await getCollection('diferenciais'))].sort(
	(a, b) => a.data.ordem - b.data.ordem,
);

const icones: Record<string, string> = {
	'anos-de-experiencia': '🏆',
	unidades: '📍',
	'pisos-e-revestimentos': '🪟',
	'marcas-parceiras': '🤝',
};

function partes(rotulo: string, destaque?: string) {
	if (!destaque) return { antes: rotulo, destaque: '', depois: '' };
	const indice = rotulo.indexOf(destaque);
	if (indice < 0) return { antes: rotulo, destaque: '', depois: '' };
	return {
		antes: rotulo.slice(0, indice),
		destaque,
		depois: rotulo.slice(indice + destaque.length),
	};
}
---

<section class="diferenciais">
	<div class="diferenciais-container">
		<ul class="diferenciais-grid">
			{
				diferenciais.map((item) => {
					const texto = partes(item.data.rotulo, item.data.destaque);
					const icone = icones[item.id];
					const visivel = [item.data.valor, item.data.rotulo].filter(Boolean).join(' ');
					const link = item.id === 'anos-de-experiencia' ? linkExperiencia : undefined;
					const conteudo = (
						<>
							{item.data.valor && <span class="diferencial-num">{item.data.valor}</span>}
							<span class="diferencial-label">
								{texto.antes}
								{texto.destaque && <span class="diferencial-destaque">{texto.destaque}</span>}
								{texto.depois}
							</span>
						</>
					);
					return (
						<li class:list={['diferencial-card', { 'sem-valor': !item.data.valor, 'com-link': Boolean(link) }]}>
							{icone && (
								<span class="diferencial-icon" aria-hidden="true">
									{icone}
								</span>
							)}
							{link ? (
								<a href={link} aria-label={`${visivel}. Saiba mais sobre a empresa`}>
									{conteudo}
								</a>
							) : (
								conteudo
							)}
						</li>
					);
				})
			}
		</ul>
	</div>
</section>

<style>
	.diferenciais {
		background: var(--color-surface);
		padding: var(--spacing-differentials) 0;
	}

	.diferenciais-container {
		max-width: var(--container-page);
		margin: 0 auto;
		padding: 0 var(--spacing-container-x);
	}

	.diferenciais-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--spacing-differentials-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.diferencial-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: var(--spacing-differential-card-y) var(--spacing-differential-card-x);
		border-top: 4px solid var(--color-brand);
		border-radius: var(--radius-card);
		background: var(--color-white);
		box-shadow: var(--shadow-card);
		text-align: center;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	.diferencial-card:hover {
		transform: translateY(-4px);
	}

	.com-link {
		position: relative;
	}

	.com-link a {
		display: flex;
		flex-direction: column;
		align-items: center;
		color: inherit;
		text-decoration: none;
	}

	.com-link a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.com-link:hover {
		box-shadow: var(--shadow-product-hover);
		transform: translateY(-6px);
	}

	.com-link a:focus-visible {
		outline: none;
	}

	.com-link:has(a:focus-visible) {
		outline: 3px solid var(--color-brand);
		outline-offset: 4px;
	}

	.diferencial-icon {
		margin-bottom: 12px;
		font-size: var(--text-differential-icon);
		line-height: 1;
	}

	.diferencial-num {
		margin-bottom: 6px;
		color: var(--color-brand);
		font-family: var(--font-display);
		font-size: var(--text-differential-number);
		font-weight: var(--font-weight-black);
		line-height: 1;
	}

	.diferencial-label {
		color: var(--color-muted);
		font-size: var(--text-differential-label);
		font-weight: var(--font-weight-label);
	}

	.sem-valor .diferencial-label {
		color: var(--color-ink);
		font-size: var(--text-differential-label-strong);
		font-weight: var(--font-weight-bold);
		line-height: 1.4;
	}

	.diferencial-destaque {
		color: var(--color-brand);
	}

	@media (min-width: 769px) {
		.diferenciais-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
