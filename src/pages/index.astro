---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Banners from '../components/sections/Banners.astro';
import Contato from '../components/sections/Contato.astro';
import Depoimentos from '../components/sections/Depoimentos.astro';
import Diferenciais from '../components/sections/Diferenciais.astro';
import Hero from '../components/sections/Hero.astro';
import Marcas from '../components/sections/Marcas.astro';
import Ofertas from '../components/sections/Ofertas.astro';
import Produtos from '../components/sections/Produtos.astro';
import Unidades from '../components/sections/Unidades.astro';
import { lojaSchema, organizationSchema, websiteSchema } from '../lib/schema';

const site = await getEntry('site', 'geral');
if (!site) {
	throw new Error('A collection site não tem o item geral.');
}

const unidades = await getCollection('unidades');
const lojas = await Promise.all(
	[...unidades]
		.sort((a, b) => a.data.ordem - b.data.ordem)
		.map((unidade) => lojaSchema(site, unidade)),
);

const sobre = await getEntry('paginas', 'sobre');
const jsonLd = [
	await organizationSchema(site, {
		fundacao: sobre?.data.fundacao,
		fundador: sobre?.data.fundador,
	}),
	websiteSchema(site),
	...lojas,
];
---

<BaseLayout
	title="Material de Construção em Poá e Suzano | José Maria Filho"
	description="Depósito José Maria Filho: mais de 23 anos em materiais para construção. Areia, cimento, pisos, revestimentos, elétrica, hidráulica e muito mais. 3 unidades em Poá e Suzano-SP."
	jsonLd={jsonLd}
>
	<Hero />
	<Banners />
	<Diferenciais linkExperiencia="/sobre/" />
	<Produtos />
	<Ofertas />
	<Unidades />
	<Marcas />
	<Depoimentos />
	<Contato />
</BaseLayout>
