---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getEntry } from 'astro:content';
import fachadaPadrao from '../../assets/images/fachada-loja-poa.png';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	ogImage?: ImageMetadata;
	ogImageAlt?: string;
	ogType?: string;
	noindex?: boolean;
}

const {
	title,
	description,
	canonical,
	ogImage,
	ogImageAlt = 'Fachada da loja do Depósito José Maria Filho em Poá, no Jardim São José',
	ogType = 'website',
	noindex = false,
} = Astro.props;

const siteEntry = await getEntry('site', 'geral');
if (!siteEntry) {
	throw new Error('A collection site não tem o item geral.');
}

const origem = Astro.site ?? new URL('https://depositojosemariafilho.com.br');
const canonica = new URL(canonical ?? Astro.url.pathname, origem);
canonica.search = '';
canonica.hash = '';
if (!canonica.pathname.endsWith('/')) {
	canonica.pathname = `${canonica.pathname}/`;
}

const og = await getImage({
	src: ogImage ?? fachadaPadrao,
	width: 1200,
	height: 630,
	format: 'jpg',
	quality: 'mid',
	fit: 'cover',
});
const ogUrl = new URL(og.src, origem).href;
const robots = noindex ? 'noindex, follow' : 'index, follow';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonica.href} />
<meta name="robots" content={robots} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content={siteEntry.data.nome} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonica.href} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content={String(og.attributes.width)} />
<meta property="og:image:height" content={String(og.attributes.height)} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
