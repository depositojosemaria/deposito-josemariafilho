---
import { Picture } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import { linkWhatsApp } from '../../lib/format';
import Carrossel from '../ui/Carrossel.astro';
import Icon from '../ui/Icon.astro';

const site = await getEntry('site', 'geral');
if (!site) {
	throw new Error('A collection site não tem o item geral.');
}

const todasOfertas = [...(await getCollection('ofertas'))];
const hoje = new Date();
function toDateOnly(str) {
	// treat empty string or missing as no validade
	if (!str) return null;
	const s = String(str).trim();
	if (!s) return null;
	// accept "YYYY-MM-DD" or ISO datetime; use only date portion
	const datePart = s.split('T')[0];
	return new Date(datePart + 'T00:00:00');
}
const ofertas = todasOfertas
	.filter((o) => {
		const ativo = o.data.ativo ?? true;
		if (!ativo) return false;
		const validade = toDateOnly(o.data.validade);
		if (!validade) return true;
		// incluir se validade >= hoje (data do build)
		return validade >= new Date(hoje.getFullYear(), hoje.getMonth(), hoje.getDate());
	})
	.sort((a, b) => a.data.ordem - b.data.ordem);
const mensagem =
	site.data.mensagemWhatsappOfertas?.trim() ||
	'Olá, vi as ofertas do mês no site e tenho interesse.';
const whatsapp = linkWhatsApp(site.data.whatsapp, mensagem);
---

<section class="ofertas" id="ofertas">
	<div class="container">
		<div class="intro">
			<h2>Ofertas do <span>Mês</span></h2>
			<p>Confira as promoções especiais — clique na imagem para ampliar</p>
		</div>
		{ofertas.length ? (
			<Carrossel label="Ofertas do mês" mobile={2} tablet={2} desktop={3} setas tema="ofertas" total={ofertas.length}>
				{
					ofertas.map((oferta) => (
						<button
							class="oferta-slide"
							type="button"
							popovertarget={`oferta-${oferta.id}`}
							aria-label={`Ampliar encarte de ofertas ${oferta.data.ordem}`}
						>
							<Picture
								src={oferta.data.imagem}
								formats={['avif', 'webp']}
								widths={[160, 240, 320, 480]}
								sizes="(min-width: 1240px) 329px, (min-width: 901px) calc((100vw - 164px) / 3 - 16px), calc(50vw - 72px)"
								alt={oferta.data.alt}
								width={oferta.data.imagem.width}
								height={oferta.data.imagem.height}
								quality="mid"
								loading="lazy"
								decoding="async"
							/>
						</button>
					))
				}
			</Carrossel>
		) : (
			<div class="sem-ofertas" role="status">
				<p>Novas ofertas em breve! Fale com a gente pelo WhatsApp para saber as promoções da semana.</p>
			</div>
		)}
		{
			ofertas.map((oferta) => (
				<div id={`oferta-${oferta.id}`} class="oferta-popover" popover aria-label={oferta.data.alt}>
					<button
						class="fechar"
						type="button"
						popovertarget={`oferta-${oferta.id}`}
						popovertargetaction="hide"
						aria-label="Fechar"
					>
						<span aria-hidden="true">✕</span>
					</button>
					<Picture
						src={oferta.data.imagem}
						formats={['avif', 'webp']}
						widths={[768, 1200, 1600, 2160]}
						sizes="92vw"
						alt={oferta.data.alt}
						width={oferta.data.imagem.width}
						height={oferta.data.imagem.height}
						quality="mid"
						loading="lazy"
						decoding="async"
					/>
				</div>
			))
		}
		<div class="ofertas-cta">
			<a class="btn-whatsapp" href={whatsapp} target="_blank" rel="noopener">
				<Icon nome="whatsapp" tamanho={20} />
				{site.data.ctaOfertas}
			</a>
		</div>
	</div>
</section>

<style>
	.ofertas {
		background: var(--color-offers);
		padding: var(--spacing-section) 0;
	}

	.container {
		max-width: var(--container-page);
		margin: 0 auto;
		padding: 0 var(--spacing-container-x);
	}

	.intro {
		text-align: center;
	}

	h2 {
		margin: 0 0 var(--spacing-title);
		color: var(--color-ink);
		font-family: var(--font-display);
		font-size: var(--text-section-title);
		font-weight: var(--font-weight-extrabold);
		line-height: var(--leading-heading);
	}

	h2 span {
		color: var(--color-brand);
	}

	.intro p {
		margin: 0 0 var(--spacing-subtitle);
		color: var(--color-muted);
		font-size: var(--text-section-subtitle);
	}

	.oferta-slide {
		margin: 0;
		padding: 0 5px;
		border: 0;
		background: transparent;
		font: inherit;
		cursor: zoom-in;
	}

	.oferta-slide :global(picture),
	.oferta-slide :global(img) {
		display: block;
	}

	.oferta-slide :global(img) {
		width: 100%;
		height: auto;
		max-height: 400px;
		border-radius: var(--radius-card);
		background: var(--color-white);
		object-fit: contain;
	}

	.oferta-popover {
		width: fit-content;
		max-width: 92vw;
		height: fit-content;
		margin: auto;
		padding: 0;
		overflow: visible;
		border: 0;
		background: transparent;
	}

	.oferta-popover::backdrop {
		background: var(--color-lightbox);
	}

	.oferta-popover :global(picture),
	.oferta-popover :global(img) {
		display: block;
	}

	.oferta-popover :global(img) {
		width: auto;
		max-width: 92vw;
		height: auto;
		max-height: 90dvh;
		object-fit: contain;
	}

	.fechar {
		position: fixed;
		top: 14px;
		right: 16px;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: 0;
		border-radius: var(--radius-circle);
		background: rgba(255, 255, 255, 0.12);
		color: var(--color-white);
		font-size: var(--text-lightbox-close);
		line-height: 1;
		cursor: pointer;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	.fechar:hover {
		background: var(--color-brand);
	}

	.ofertas-cta {
		display: flex;
		justify-content: center;
		margin-top: 22px;
	}
	.sem-ofertas {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
		padding: 22px 0;
	}

	.btn-whatsapp {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		max-width: 320px;
		padding: 12px 18px;
		border-radius: var(--radius-pill);
		background: var(--color-whatsapp);
		color: var(--color-white);
		font-family: var(--font-display);
		font-size: var(--text-offers-cta-compact);
		font-weight: var(--font-weight-bold);
		text-decoration: none;
		transition: all var(--default-transition-duration) var(--ease-brand);
	}

	.btn-whatsapp:hover {
		background: var(--color-whatsapp-dark);
	}

	@media (min-width: 901px) {
		.oferta-slide {
			padding: 0 8px;
		}

		.oferta-slide :global(img) {
			max-height: 580px;
		}

		.btn-whatsapp {
			width: auto;
			max-width: none;
			padding: 13px 26px;
			font-size: var(--text-btn);
		}
	}
</style>
