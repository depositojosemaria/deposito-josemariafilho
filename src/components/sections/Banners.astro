---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Carrossel from '../ui/Carrossel.astro';

const banners = [...(await getCollection('banners'))].sort((a, b) => a.data.ordem - b.data.ordem);
const total = banners.length;
---

<section class="banners">
	<Carrossel label="Destaques" mobile={1} tablet={1} desktop={1} setas indicadores tema="banner">
		{
			banners.map((banner, indice) => (
				<div
					class="banner-slide"
					role="group"
					aria-roledescription="slide"
					aria-label={`${indice + 1} de ${total}`}
				>
					{banner.data.link ? (
						<a href={banner.data.link}>
							<Picture
								src={banner.data.imagem}
								formats={['avif', 'webp']}
								widths={[420, 640, 768, 1024, 1440, 1920]}
								sizes="100vw"
								alt={banner.data.alt}
								width={banner.data.imagem.width}
								height={banner.data.imagem.height}
								quality="mid"
								loading={indice === 0 ? 'eager' : 'lazy'}
								decoding="async"
							/>
						</a>
					) : (
						<Picture
							src={banner.data.imagem}
							formats={['avif', 'webp']}
							widths={[420, 640, 768, 1024, 1440, 1920]}
							sizes="100vw"
							alt={banner.data.alt}
							width={banner.data.imagem.width}
							height={banner.data.imagem.height}
							quality="mid"
							loading={indice === 0 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					)}
				</div>
			))
		}
	</Carrossel>
</section>

<style>
	.banners {
		position: relative;
		overflow: hidden;
		background: var(--color-banner);
		line-height: 0;
	}

	.banner-slide {
		width: 100%;
	}

	.banner-slide :global(picture),
	.banner-slide :global(a) {
		display: block;
	}

	.banner-slide :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
